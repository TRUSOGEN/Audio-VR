* text=auto eol=lf

# Unity YAML assets should remain mergeable text files.
*.meta    text eol=lf
*.asset   text eol=lf
*.prefab  text eol=lf
*.unity   text eol=lf
*.mat     text eol=lf
*.anim    text eol=lf
*.controller text eol=lf

# Binary source assets.
*.png binary
*.jpg binary
*.jpeg binary
*.fbx binary
*.glb binary
*.ogg binary
*.wav binary
*.mp3 binary
